# Django Security Settings
SECRET_KEY=django-insecure-zero-day-graphids-change-this-in-production-token-7x9q!m2
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (default: sqlite3)
# Set USE_POSTGRES=True to enable PostgreSQL in Docker/production
USE_POSTGRES=False
DB_NAME=zeroday_graphids
DB_USER=graphids_user
DB_PASSWORD=graphids_password
DB_HOST=localhost
DB_PORT=5432

# Machine Learning Device Settings (cpu or cuda)
ML_DEVICE=cpu

# Optional Celery & Redis Configuration
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
